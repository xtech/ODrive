-    std::memcpy(&valAsBits, &val, sizeof(val));
-
-    uint64_t mask = length < 64 ? (1ULL << length) - 1ULL : -1ULL;
-
-    if (isIntel) {
-        uint64_t data = 0;
-        std::memcpy(&data, msg.buf, sizeof(data));
-
-        data &= ~(mask << startBit);
-        data |= valAsBits << startBit;
-
-        std::memcpy(msg.buf, &data, sizeof(data));
-    } else {
